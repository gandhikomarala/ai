# Environment & Application
ENVIRONMENT=development
DEBUG=true
APP_NAME=AegisAI
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=aegisai-super-secret-jwt-key-for-local-development-minimum-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
ALGORITHM=HS256

# Database (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aegisai
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aegisai
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/aegisai
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Redis (Cache, Rate Limiting, Celery Broker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object Storage (MinIO / AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=aegisai-documents
S3_REGION=us-east-1
S3_SECURE=false

# Graph Database (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aegisai_password
NEO4J_ENABLED=true

# AI / LLM Providers
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o
FAST_LLM_MODEL=gpt-4o-mini
REASONING_LLM_MODEL=gpt-4o
OPENAI_API_KEY=mock-openai-key-for-dev
ANTHROPIC_API_KEY=mock-anthropic-key-for-dev
NVIDIA_API_KEY=mock-nvidia-key-for-dev
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=1536
RERANKER_PROVIDER=flashrank
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2

# Security & Limits
MAX_UPLOAD_SIZE_MB=50
MAX_AGENT_STEPS=15
AGENT_TIMEOUT_SECONDS=60
DEFAULT_USER_ROLE=ENGINEER
PROMPT_INJECTION_PROTECTION=true
PII_MASKING_ENABLED=true
READ_ONLY_SQL_ENFORCEMENT=true

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_METRICS_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-mock
LANGFUSE_SECRET_KEY=sk-lf-mock
LANGFUSE_HOST=http://localhost:3000
